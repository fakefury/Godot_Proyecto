; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hit Mask Change Organizado"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Hit Mask Change/Assets/UI/": "teal",
"res://Hit Mask Change/Datos (vida, velocidad, etc)/": "gray",
"res://Hit Mask Change/Escenas/Bloques para Mapa/": "pink",
"res://Hit Mask Change/Escenas/Niveles/": "pink",
"res://Hit Mask Change/Escenas/Personajes/": "yellow",
"res://Hit Mask Change/Escenas/UI/": "teal",
"res://Hit Mask Change/Scripts/Daño/": "red",
"res://Hit Mask Change/Scripts/Habilidades/": "orange",
"res://Hit Mask Change/Scripts/Managers/": "gray",
"res://Hit Mask Change/Scripts/Personajes/": "yellow",
"res://Hit Mask Change/Scripts/UI/": "teal"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
